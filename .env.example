# ==============================================================================
# Planora AI - Environment Variables Template
# Copy this file to .env.local and populate the secrets.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# MongoDB Atlas Connection String (Official mongodb Node.js driver)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"

# Target MongoDB Database Name (e.g. planora_ai)
MONGODB_DB="planora_ai"
# Optional legacy alias:
# MONGODB_DB_NAME="planora_ai"

# Google Gemini API Key (Official @google/genai SDK)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.8-flash"

# Authentication & Session Security (jose + bcryptjs)
# Required for production: cryptographically secure secret (min 32 characters) used to sign and verify session JWTs.
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-character-or-longer-random-secret-key-here"

# Public Application URL (Used for canonical links and metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development | production | test)
NODE_ENV="development"
